# Copie para backend/.env
# cp .env.example .env

# Backend de dados:
# - mock: roda sem conexão externa (bom para subir local rapidamente)
# - postgres: usa banco remoto
DATA_BACKEND=mock

# Banco remoto (use quando DATA_BACKEND=postgres)
# Se sua senha tiver caracteres especiais, mantenha como URL completa.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# Escopo do MVP
MVP_ONLY_NORDESTE=true

# Front local
CORS_ORIGINS=http://localhost:5173

# Curtailment model runtime
CURTAILMENT_MODEL_PATH=models_ml/curtailment_model.pkl
CURTAILMENT_MODEL_MODE=auto
CURTAILMENT_MODEL_ADVANCED_PATH=models_ml/curtailment_model_advanced.pkl
CURTAILMENT_ADVANCED_MODULE_PATH=models_ml/data_ml/models.py
