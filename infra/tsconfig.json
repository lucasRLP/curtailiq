{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "cdk.out", "dist", "lambda-bundle"]
}
