{
 "Version":"2012-10-17",
 "Statement":[
  {"Sid":"InvalidateOnlyTaggedProjectDistribution","Effect":"Allow","Action":["cloudfront:CreateInvalidation","cloudfront:GetInvalidation"],"Resource":"arn:aws:cloudfront::${AWS_ACCOUNT_ID}:distribution/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"curtailai"}}},
  {"Sid":"EcrLoginGlobalRequired","Effect":"Allow","Action":"ecr:GetAuthorizationToken","Resource":"*"},
  {"Sid":"PublishExistingImageRepository","Effect":"Allow","Action":["ecr:BatchCheckLayerAvailability","ecr:CompleteLayerUpload","ecr:InitiateLayerUpload","ecr:PutImage","ecr:UploadLayerPart","ecr:BatchGetImage","ecr:GetDownloadUrlForLayer","ecr:DescribeImages","ecr:DescribeRepositories"],"Resource":"arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/curtailai/backend"},
  {"Sid":"NamedStackChangesWithExecutionRole","Effect":"Allow","Action":["cloudformation:CreateChangeSet","cloudformation:CreateStack","cloudformation:UpdateStack"],"Resource":"arn:aws:cloudformation:${AWS_REGION}:${AWS_ACCOUNT_ID}:stack/curtailai-demo/*","Condition":{"ArnEquals":{"cloudformation:RoleArn":"arn:aws:iam::${AWS_ACCOUNT_ID}:role/curtailai-cloudformation-execution"}}},
  {"Sid":"NamedStackReviewAndExecute","Effect":"Allow","Action":["cloudformation:DescribeChangeSet","cloudformation:DeleteChangeSet","cloudformation:ExecuteChangeSet","cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:GetTemplate","cloudformation:ListStackResources"],"Resource":"arn:aws:cloudformation:${AWS_REGION}:${AWS_ACCOUNT_ID}:stack/curtailai-demo/*"},
  {"Sid":"PassOnlyExecutionRoleToCloudFormation","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::${AWS_ACCOUNT_ID}:role/curtailai-cloudformation-execution","Condition":{"StringEquals":{"iam:PassedToService":"cloudformation.amazonaws.com"}}},
  {"Sid":"FrontendBucketMetadata","Effect":"Allow","Action":["s3:ListBucket","s3:GetBucketLocation"],"Resource":"arn:aws:s3:::curtailai-frontend-${AWS_ACCOUNT_ID}-${AWS_REGION}"},
  {"Sid":"FrontendPublish","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject"],"Resource":"arn:aws:s3:::curtailai-frontend-${AWS_ACCOUNT_ID}-${AWS_REGION}/*"}
 ]
}
